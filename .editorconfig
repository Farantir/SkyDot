# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

# Trailing double spaces are a line break in Markdown.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# git writes this file with tabs.
[.gitmodules]
indent_style = tab

# GDScript under game/ uses tabs, as the Godot editor does. The smoke tests
# and most scripts in game/tools/ use four spaces. A file must not mix them.
[*.gd]
indent_style = tab

[engine/tests/smoke/*.gd]
indent_style = space

[engine/game/tools/*.gd]
indent_style = space

[engine/game/tools/{actor_check,door_check,preload_check}.gd]
indent_style = tab

# Shaders under engine/game/shaders/ use tabs, as Godot's shader editor does,
# and keep the layout they had as C++ string literals.
[engine/game/shaders/*.{gdshader,gdshaderinc,comp}]
indent_style = tab

# Submodules keep their own style.
[{engine/extern/{catch2,flatbuffers,godot-cpp},converter/extern/{bc7enc_rdo,nifly}}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
