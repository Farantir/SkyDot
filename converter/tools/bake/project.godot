; Bake project with pinned importer defaults. Without them Godot uses the
; defaults of whichever editor first imports, so bakes would differ between
; machines. Values are explicit, not tuned.

config_version=5

[application]

config/name="bethconv bake"
config/features=PackedStringArray("4.7")

[importer_defaults]

scene={
; The converter already applies the unit scale; do not scale again.
"nodes/apply_root_scale": true,
"nodes/root_scale": 1.0,
"nodes/root_type": "",
"nodes/import_as_skeleton_bones": false,
; Off: Skyrim ships its own LOD meshes, so generated LODs would go unused.
"meshes/generate_lods": false,
"meshes/create_shadow_meshes": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"meshes/force_disable_compression": false,
"meshes/ensure_tangents": true,
"skins/use_named_skins": true,
"animation/import": true,
"animation/fps": 30,
"animation/trimming": false,
"animation/remove_immutable_tracks": true,
"import_script/path": "",
"_subresources": {}
}
