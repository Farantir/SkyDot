; The game project: `.tscn`/`.gd` glue only, never a hot path. The real work is
; in extension/, loaded via skydot.gdextension.

config_version=5

[application]

config/name="skydot"
; The pack tool; the viewer runs as res://viewer/cell_viewer.tscn.
run/main_scene="res://packtool/pack_tool.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1100
window/size/viewport_height=800

[input]

; The viewer's controls (viewer/player_input.gd). Keys are logical ones, as the
; viewer always read them (WASD by label, not by position); a gamepad or VR
; shell maps its own events to the same actions.
