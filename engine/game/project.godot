; The game project: `.tscn`/`.gd` glue only, never a hot path. The real work is
; in extension/, loaded via skydot.gdextension.

config_version=5

[application]

config/name="skydot"
; The pack tool; the viewer runs as res://viewer/cell_viewer.tscn.
run/main_scene="res://packtool/pack_tool.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1100
window/size/viewport_height=800

[rendering]

renderer/rendering_method="forward_plus"
; No light limit: the game's (7 point lights per object, 4 of them shadowed)
; was a limit of its renderer, not wanted here. Forward+ has no per-object
; limit; these raise its per-view ones well past the busiest vanilla
; interior (DLC1Arkngthamz01: 122 lights, all flagged for shadows).
; Clustered: lights, decals and probes in view (default 512).
limits/cluster_builder/max_clustered_elements=4096
; Shadowed omni and spot lights in view: 4 + 16 + 64 + 256 = 340 (default
; 88), same 4096 atlas, so no more memory; small lights get small tiles.
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=5

[physics]

3d/physics_engine="Jolt Physics"

[navigation]

; Navmesh vertices are kept as Skyrim placed them; a coarse cell would merge
; nearby ones. Portals between cells' navmeshes lie up to 64 units (0.9 m)
; apart, so free edges within 1 m are joined (docs/navigation.md).
3d/default_cell_size=0.01
3d/default_cell_height=0.01
3d/default_edge_connection_margin=1.0
; About 1.6% of vanilla navmeshes have edges shared by more than two
; triangles; Godot skips the extra connection and would warn every time.
3d/warnings/navmesh_edge_merge_errors=false
