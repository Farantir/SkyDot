// SPDX-License-Identifier: GPL-3.0-or-later
//
// Schema for the index part of `records.fb`. Record payloads live in a separate
// blob with 64-bit offsets, because FlatBuffers are limited to 2 GiB and
// vanilla SE's payloads alone are 527 MiB. See
// `include/bethconv/pack/snapshot.hpp` and `docs/format-notes/snapshot.md`.
//
// A `records.fb` is derived from the user's own files on their machine and is
// never redistributed.

namespace bethconv.pack.fb;

/// One form after the load order is applied.
///
/// A struct, not a table: at 1.18M forms that is 47 MiB instead of ~130 MiB,
/// and `forms` becomes a contiguous, binary-searchable array. Structs cannot
/// hold strings or vectors, so the editor id and payload are referenced. Field
/// order packs to 40 bytes without padding.
struct Form {
    /// Payload offset in the blob (64-bit; see above).
    payload_offset: uint64;

    /// Global FormID; the only identity downstream code uses.
    id: uint32;

    /// Record type FourCC, in file byte order.
    type: uint32;

    /// Enclosing CELL or WRLD, global; 0 at top level. Innermost, so a REFR's
    /// parent is its CELL and an exterior CELL's parent is its WRLD.
    parent: uint32;

    /// The winning record's header flags.
    flags: uint32;

    payload_bytes: uint32;

    /// Number of earlier plugins that also wrote this form (useful when
    /// debugging a mod list; lost after flattening otherwise).
    overrides: uint32;

    /// Indices into `Snapshot.plugins`: winning plugin and owner of the FormID
    /// space. For `bethconv verify` and debugging; not used by the engine.
    winner: uint16;
    owner: uint16;

    /// Bit 0: winner is deleted. Bit 1: injected (no writer owns the space).
    /// Deleted forms stay in the snapshot; consumers filter.
    status: uint8;
}

/// One exterior cell in its worldspace grid. `key` packs XCLC's two int32 as
/// `(int64(x) << 32) | uint32(y)` so lookup is a binary search. Both
/// coordinates can be negative.
struct GridCell {
    key: int64;
    cell: uint32;
}

/// The exterior cells of one worldspace, sorted by `key`.
table WorldGrid {
    world: uint32;
    cells: [GridCell];
}

/// All forms of one record type, sorted.
table TypeSpan {
    type: uint32;
    forms: [uint32];
}

/// Forms whose `parent` is `parent`, sorted. Duplicates Form.parent so cell
/// contents are one binary search instead of a scan.
table ChildList {
    parent: uint32;
    children: [uint32];
}

table Snapshot {
    /// Bumped when the meaning of anything here changes; a mismatch is refused.
    format_version: uint32;

    /// Converter, and the `.STRINGS` language names were resolved in.
    converter: string;
    language: string;

    /// Load order this world was built from. Provenance only.
    plugins: [string];

    /// Every form, sorted by `id`.
    forms: [Form];

    /// Editor id -> form id as two parallel arrays sorted by name. Only records
    /// with an EDID appear; EDIDs are read generically, so all record types are
    /// covered.
    editor_ids: [string];
    editor_id_forms: [uint32];

    /// Sorted by `type`, `parent` and `world` respectively.
    types: [TypeSpan];
    children: [ChildList];
    worlds: [WorldGrid];

    /// Merge statistics, so a snapshot can be checked against its load order.
    visited: uint64;
    collapsed: uint64;
    deleted: uint64;
    injected: uint64;
    unresolved: uint64;
}

root_type Snapshot;
file_identifier "BSN1";
