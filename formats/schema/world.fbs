// SPDX-License-Identifier: GPL-3.0-or-later
//
// Schema of `world.fb`: what the engine needs to build cells, decoded by the
// converter. Every FormID in here is global (resolved through the load order).
//
// Positions and rotations are in Skyrim's own space: Z-up, game units,
// rotation in radians. The engine converts them.
//
// A vector said to be sorted by `id` or `ref` has that field marked `(key)`: its
// values are unique and in increasing order, and flatc generates `LookupByKey`
// for the vector. Vectors sorted by a field that can repeat (a reference's
// linked references, activate parents and primitives) have no key; search
// them for the range of one reference.
//
// A flag word is a `bit_flags` enum, named for the field or the record it
// belongs to: the values in an enum are bit numbers, flatc turns them into
// masks, and both halves test bits by these names. The words are mostly
// the plugin's own, as stored, so a bit can be set that the enum does not
// name; only bits one of the halves acts on are named.

namespace bethconv.pack.wfb;

struct Vec3f {
    x: float;
    y: float;
    z: float;
}

/// `Ref.flags` and `ActorRef.flags`.
enum RefFlags : uint32 (bit_flags) {
    initially_disabled,
    persistent,
    /// The enable state is the opposite of `enable_parent`'s.
    enable_opposite,
    /// Only activate parents can activate it (XAPD).
    parent_activate_only,
    /// The REFR's record flag 0x8000: the reference is in object LOD (format
    /// 11). A reference's base can have the same flag (`RecordFlags`).
    visible_when_distant
}

/// One placed reference (REFR). Deleted references are not included.
struct Ref {
    id: uint32 (key);
    /// The placed base record (a `Base` in `bases`, if it has a model or light).
    base: uint32;
    position: Vec3f;
    rotation: Vec3f;
    scale: float;
    flags: RefFlags;
    /// 0 if none.
    enable_parent: uint32;
}

/// A placed light's own settings (format 10; REFR XRDS and XLIG, xEdit's
/// names): the radius, added to the LIGH record's, and XLIG's FOV (added to
/// 90), fade, end distance cap and shadow depth bias. `has_*` say which the
/// reference has.
struct LightOverride {
    ref: uint32 (key);
    has_radius: bool;
    radius: float;
    has_light_data: bool;
    fov: float;
    fade: float;
    end_distance_cap: float;
    shadow_depth_bias: float;
}

/// A placed light that takes its colour from a region's weather (format 12;
/// REFR XEMI). Vanilla uses it to switch street fires and window lights with
/// the time of day: the region's only weather has a black sunlight colour by
/// day and a white one at night, and the light is its own colour times that
/// (the cave weathers carry blue and warm ones). `source` is a REGN.
struct LightEmitter {
    ref: uint32 (key);
    source: uint32;
}

/// A reference that is a load door: where it leads.
struct DoorLink {
    ref: uint32 (key);
    destination: uint32;
    position: Vec3f;
    rotation: Vec3f;
}

/// XLOC. Level 0-100, 255 needs the key.
struct Lock {
    ref: uint32 (key);
    level: ubyte;
    /// Bit 2: levelled lock.
    flags: ubyte;
    /// A KEYM; 0 if none.
    key: uint32;
}

/// XLKR: a linked reference, optionally named by a keyword.
struct LinkedRef {
    ref: uint32;
    keyword: uint32;
    target: uint32;
}

/// XAPR: activating `parent` activates `ref` after `delay` seconds.
struct ActivateParent {
    ref: uint32;
    parent: uint32;
    delay: float;
}

/// XPRM: the volume of a trigger, occlusion plane or room marker, centred on
/// the reference and turned with it. `bounds` as stored (game units); whether
/// they are half or full extents is not yet checked against the game. Type 1
/// box, 2 sphere (source: UESP, REFR record); other values as stored.
struct Primitive {
    ref: uint32;
    bounds: Vec3f;
    type: uint32;
}

/// A form or quest alias a script property points at.
struct ScriptObject {
    form: uint32;
    /// An alias index of the quest `form`, or -1.
    alias: short;
}

/// VMAD property. Type 1-5: object, string, int, float, bool; 11-15 arrays of
/// those. A scalar is the single element of its vector; bools are ints.
table ScriptProperty {
    name: string;
    type: ubyte;
    /// 1 edited, 3 removed (bit 1: the property's value is not set here).
    status: ubyte;
    objects: [ScriptObject];
    strings: [string];
    ints: [int];
    floats: [float];
}

/// `Script.status`: 0 local, 1 inherited, 2 removed, 3 inherited and removed.
enum ScriptStatus : ubyte (bit_flags) {
    inherited,
    removed
}

table Script {
    name: string;
    status: ScriptStatus;
    properties: [ScriptProperty];
}

/// VMAD of one reference.
table RefScripts {
    ref: uint32 (key);
    scripts: [Script];
}

/// Decoded XCLL, from its 92-byte form or the 72 and 64-byte forms that
/// Skyrim.esm also has. A shorter form lacks the fog far colour, fog max, light
/// fade distances and inherit flags, which read as: fog far colour = fog near
/// colour, fog max 1, fade distances 0 and 0, no inherit flags. Colors are RGBA
/// bytes packed little-endian (red in the low byte). Source: UESP, CELL record,
/// XCLL; xEdit's definitions for the shorter forms.
struct CellLighting {
    ambient: uint32;
    directional: uint32;
    fog_near_color: uint32;
    fog_far_color: uint32;
    fog_near: float;
    fog_far: float;
    fog_power: float;
    fog_max: float;
    directional_rotation_xy: int32;
    directional_rotation_z: int32;
    directional_fade: float;
    light_fade_begin: float;
    light_fade_end: float;
    /// Which values come from the lighting template instead.
    inherit: uint32;
}

/// One texture layer of a terrain quadrant (LAND BTXT, or ATXT with its VTXT).
table TerrainLayer {
    /// An LTEX in `land_textures`; 0 means the engine's default texture.
    texture: uint32;
    /// 0 south-west, 1 south-east, 2 north-west, 3 north-east.
    quadrant: ubyte;
    /// -1 for the base layer, else the ATXT layer index (0..5 in vanilla),
    /// drawn in ascending order over the base.
    layer: short;
    /// VTXT: vertex indices in the quadrant's 17x17 grid (row-major from its
    /// south-west corner) and their opacity, 0..255 for 0..1. Points not listed
    /// are 0. Empty for the base layer.
    points: [ushort];
    opacity: [ubyte];
}

/// LAND. The 33x33 vertex grid spans the cell's 4096 units, 128 apart, rows
/// running south to north, columns west to east. Heights are VHGT's: the
/// running sum of `height_deltas`, down column 0 for the first vertex of each
/// row and then along the row, starting at `height_offset`, times 8 units.
/// Normals are not stored; they follow from the heights to within about a
/// degree.
table Terrain {
    height_offset: float;
    /// 33 x 33.
    height_deltas: [byte];
    /// VCLR, 33 x 33 RGB, or empty.
    colours: [ubyte];
    /// Sorted by quadrant, then layer.
    layers: [TerrainLayer];
}

/// `NavTriangle.flags`; the others are as stored.
enum NavTriangleFlags : uint16 (bit_flags) {
    /// Edge k (v0-v1, v1-v2, v2-v0) is a link: see `NavTriangle.e0`.
    edge0_link,
    edge1_link,
    edge2_link,
    preferred = 6,
    water = 9,
    in_front_of_door = 10
}

/// A navmesh triangle (NVNM). Vertices index the navmesh's `vertices`.
struct NavTriangle {
    v0: ushort;
    v1: ushort;
    v2: ushort;
    /// Per edge (v0-v1, v1-v2, v2-v0): the neighbouring triangle, -1 for
    /// none, or an index into `links` if the edge's flag bit is set.
    e0: short;
    e1: short;
    e2: short;
    flags: NavTriangleFlags;
    /// As stored; per-edge cover, not decoded.
    cover: ushort;
}

/// An edge leading into another navmesh's triangle. Type 0: a portal, the
/// two edges side by side (within a few units across, up to about 64
/// vertically). Types 1 and 2 come in equal numbers and join edges far
/// apart (ledges).
struct NavLink {
    type: uint32;
    /// A NavMesh id, in this cell or another.
    navmesh: uint32;
    triangle: short;
}

/// A triangle in front of a door.
struct NavDoor {
    triangle: short;
    /// The door's reference.
    door: uint32;
}

/// NAVM: a cell's navmesh. Positions are in Skyrim's space, as everywhere.
table NavMesh {
    id: uint32 (key);
    vertices: [Vec3f];
    triangles: [NavTriangle];
    links: [NavLink];
    doors: [NavDoor];
}

/// `Cell.flags`: CELL DATA flags, as stored (source: UESP, CELL record).
enum CellFlags : uint16 (bit_flags) {
    interior,
    /// The cell has water at `water_height`.
    has_water,
    /// Interiors only.
    cant_travel_from_here,
    no_lod_water,
    public_area = 5,
    hand_changed,
    show_sky,
    use_sky_lighting
}

table Cell {
    id: uint32 (key);
    editor_id: string;
    /// Worldspace for exterior cells, 0 for interiors.
    world: uint32;
    flags: CellFlags;
    has_grid: bool;
    grid_x: int32;
    grid_y: int32;
    water_height: float;
    has_lighting: bool;
    lighting: CellLighting;
    lighting_template: uint32;
    /// Sorted by id.
    refs: [Ref];
    /// Sorted by ref.
    doors: [DoorLink];
    /// Exterior cells with a LAND record.
    terrain: Terrain;
    /// XCWT, a WATR in `waters`; 0 means the worldspace's water.
    water: uint32;
    /// A worldspace's persistent cell (record flag 0x400). It has grid (0, 0)
    /// like the real cell there, but holds the persistent references of the
    /// whole worldspace; place them by position.
    persistent: bool;
    /// These are all sorted by ref; a reference has one entry in `scripts` and
    /// `locks`, and any number in the others.
    scripts: [RefScripts];
    locks: [Lock];
    links: [LinkedRef];
    activate_parents: [ActivateParent];
    primitives: [Primitive];
    /// Sorted by id.
    navmeshes: [NavMesh];
    /// Sorted by ref (format 10).
    light_overrides: [LightOverride];
    /// Interiors (format 10): the directional ambient of XCLL, or of the
    /// lighting template where the cell inherits its ambient: x+, x-, y+,
    /// y-, z+, z-, RGBA bytes. Empty if neither has one.
    directional_ambient: [uint];
    /// XCIM, an ImageSpace in `image_spaces`; 0 if none (format 10).
    image_space: uint32;
    /// Sorted by ref (format 12).
    light_emitters: [LightEmitter];
    /// XCCM, a Region in `regions` (format 17): the region whose weather
    /// fills the sky seen through the openings of an interior with the
    /// show_sky flag; 0 if none.
    sky_region: uint32;
    /// FULL (format 25): the name a load door into the cell shows; empty if none.
    name: string;
    /// XLCN (format 26): a Location in `locations`; 0 if none. Exterior cells
    /// have one too.
    location: uint32;
}

/// `LightData.flags`: LIGH DATA flags (source: UESP, LIGH record). A
/// hemisphere shadow light has no direction of its own; the engine draws it as
/// an omni light with shadows.
enum LightFlags : uint32 (bit_flags) {
    dynamic,
    can_be_carried,
    negative,
    flicker,
    off_by_default = 5,
    flicker_slow,
    pulse,
    pulse_slow,
    spot_light = 10,
    spot_shadow,
    hemisphere_shadow,
    omni_shadow
}

/// LIGH DATA and FNAM. Color is RGBA bytes, red in the low byte.
struct LightData {
    radius: uint32;
    color: uint32;
    flags: LightFlags;
    falloff_exponent: float;
    fov: float;
    near_clip: float;
    fade: float;
    flicker_period: float;
    flicker_intensity: float;
    flicker_movement: float;
}

/// `Base.record_flags`: the record header's flags, of which one is named.
enum RecordFlags : uint32 (bit_flags) {
    /// Editor markers (XMarker, furniture markers): the game does not draw
    /// them.
    /// STAT and the like: the object is in object LOD (format 11).
    visible_when_distant = 15,
    editor_marker = 23
}

/// A base record that references can place: anything with a model or scripts,
/// plus lights.
table Base {
    id: uint32 (key);
    type: uint32;
    editor_id: string;
    /// Normalized virtual path (`meshes/...`), or empty. For ARMO the world
    /// model (MOD2, else MOD4).
    model: string;
    has_light: bool;
    light: LightData;
    /// Type-specific flags: DOOR FNAM (bit 1 automatic, 2 hidden, 3 minimal
    /// use, 4 sliding); CONT DATA (bit 1 respawns, format 28).
    flags: uint32;
    /// VMAD.
    scripts: [Script];
    record_flags: RecordFlags;
    /// STAT DNAM (format 10): the directional material, a MaterialObject in
    /// `material_objects` (0 if none), and its max angle in degrees.
    directional_material: uint32;
    directional_max_angle: float;
    /// MODS (format 16): the shapes of `model` whose textures the record
    /// replaces with a texture set's.
    alternate_textures: [AlternateTexture];
    /// KWDA (format 22): Keywords in `keywords`, for the bases that are in
    /// this table anyway (a model or scripts); a reference has none of its own.
    keywords: [uint32];
    /// DEST with its stages (format 23); absent if the record has none.
    destruction: Destruction;
    /// FULL (format 24): the display name, localized; empty if none.
    name: string;
    /// RNAM of ACTI and FLOR (format 24): the activation verb that replaces
    /// the default ("Open", "Search"...); empty if none.
    activate_text: string;
    /// Set for every item base that can be carried (format 28).
    item: ItemData;
    /// CONT CNTO (format 28): the start inventory. An entry's form can be a
    /// LeveledList (LVLI); the engine resolves it on first touch.
    items: [NpcItem];
    /// FLOR and TREE with PFIG (format 29); absent if the record has none.
    harvest: Harvest;
    /// FURN WBDT byte 0 (format 29): 0 none, 1 create object (forge, smelter,
    /// tanning rack, cook pot), 2 smithing weapon (grindstone), 3 enchanting,
    /// 4 enchanting experiment, 5 alchemy, 6 alchemy experiment, 7 smithing
    /// armor (workbench).
    bench_type: ubyte;
    /// FURN WBDT byte 1 (format 29): the skill the bench uses.
    bench_skill: ubyte;
}

/// What a plant or tree gives (format 29; FLOR and TREE).
table Harvest {
    /// PFIG: an INGR, or a LVLI.
    ingredient: uint32;
    /// SNAM: a sound descriptor, 0 if none.
    sound: uint32;
    /// PFPC: the chance in percent per season, byte 0 spring, 1 summer,
    /// 2 autumn, 3 winter.
    seasonal_yield: uint32;
}

/// `ItemData.category`.
enum ItemCategory : ubyte {
    misc,
    weapon,
    armor,
    clothing,
    jewelry,
    potion,
    food,
    ingredient,
    book,
    key,
    soul_gem,
    scroll,
    ammo,
    light
}

/// What a carriable item base is (format 28; ALCH, AMMO, ARMO, BOOK, INGR,
/// KEYM, LIGH with the carry flag, MISC, SLGM, SCRL, WEAP). Sources: UESP
/// and xEdit record layouts.
table ItemData {
    category: ItemCategory;
    weight: float;
    value: int32;
    /// False for the record's non-playable flag (ARMO, WEAP, BOOK: record
    /// flag 4; AMMO: DATA flag 2). The inventory hides these.
    playable: bool = true;
    /// ETYP of ARMO and WEAP, an EQUP id; 0 if none.
    equip_slot: uint32;
    /// WEAP DNAM animation type: 0 hand to hand, 1 one-handed sword, 2 dagger,
    /// 3 axe, 4 mace, 5 two-handed sword, 6 two-handed axe, 7 bow, 8 staff,
    /// 9 crossbow.
    weapon_type: ubyte;
    /// WEAP DATA damage, AMMO DATA damage.
    damage: float;
    /// ARMO DNAM / 100.
    armor_rating: float;
    /// ARMO BOD2 armor type: 0 light, 1 heavy, 2 clothing.
    armor_type: ubyte;
    /// ARMO BOD2 or BODT: bit n is body slot 30 + n.
    biped_slots: uint32;
    /// ALCH food flag.
    food: bool;
    /// INGR, ALCH and SCRL effects (format 29).
    effects: [EffectItem];
    /// EITM of WEAP and ARMO (format 29): an Enchantment in `enchantments`, 0
    /// if none.
    enchantment: uint32;
    /// WEAP DNAM (format 30): bytes 4 and 8, the swing speed and the reach
    /// (both 1.0 on a sword). Sources: xEdit's WEAP DNAM layout, checked
    /// against the Iron Sword.
    speed: float = 1;
    reach: float = 1;
    /// WEAP DNAM byte 76 (format 30): the skill as an actor value index (6
    /// OneHanded, 7 TwoHanded, 8 Marksman), -1 for anything but a weapon.
    weapon_skill: int32 = -1;
    /// WEAP CRDT (format 30): bytes 0 (uint16, the critical damage) and 4
    /// (float, the multiplier of the base damage).
    crit_damage: int32;
    crit_mult: float;
    /// WEAP DNAM byte 96 (format 30): the stagger.
    stagger: float;
    /// WEAP INAM (format 30): an ImpactDataSet in `impact_data_sets`; 0 if none.
    impact_data_set: uint32;
    /// WEAP WNAM (format 30): the model of the STAT it points to (the
    /// first-person weapon); empty if none.
    first_person_model: string;
    /// WEAP NAM9 and NAM8 (format 30): SoundDescriptors in
    /// `sound_descriptors`; 0 if none.
    equip_sound: uint32;
    unequip_sound: uint32;
}

/// EFID and EFIT (format 29): a magic effect with its strength.
struct EffectItem {
    /// A MagicEffect in `magic_effects`.
    effect: uint32;
    magnitude: float;
    area: uint32;
    duration: uint32;
}

/// COBJ (format 29): a constructible object. The bench is chosen by
/// `bench_keyword`, which the furniture carries in `Base.keywords`.
table Recipe {
    id: uint32 (key);
    editor_id: string;
    /// CNAM: the created form.
    product: uint32;
    /// NAM1.
    product_count: int32 = 1;
    /// BNAM: a Keyword.
    bench_keyword: uint32;
    /// CNTO.
    components: [NpcItem];
    /// CTDA.
    conditions: [Condition];
}

/// MGEF (format 29). Sources: UESP and xEdit record layouts.
table MagicEffect {
    id: uint32 (key);
    editor_id: string;
    name: string;
    /// DNAM, with its `<mag>` and `<dur>` placeholders.
    description: string;
    /// DATA flags: 0x1 hostile, 0x4 recover, 0x200000 power affects
    /// magnitude, 0x400000 power affects duration, among others.
    flags: uint32;
    base_cost: float;
    /// The magic skill as an actor value index, -1 if none.
    magic_skill: int32;
    actor_value: int32;
    archetype: uint32;
    /// 0 constant, 1 fire and forget, 2 concentration, 3 scroll.
    casting_type: uint32;
    /// 0 self, 1 touch, 2 aimed, 3 target actor, 4 target location.
    delivery: uint32;
    keywords: [uint32];
}

/// ENCH (format 29).
table Enchantment {
    id: uint32 (key);
    editor_id: string;
    name: string;
    /// ENIT cost.
    cost: int32;
    /// ENIT enchantment amount: the charge.
    charge: int32;
    effects: [EffectItem];
}

/// DEST, DSTD and DMDL (format 23). A stage opens when the object's health
/// has fallen to `health_percent` of `Destruction.health`; the stages are in
/// record order, and the script-side stage number is the count of stages
/// opened (0: intact, 1: the first stage, ...).
table Destruction {
    health: int32;
    /// DEST byte 5.
    flags: ubyte;
    stages: [DestructionStage];
}

table DestructionStage {
    /// DSTD byte 0.
    health_percent: ubyte;
    /// DSTD byte 1.
    index: ubyte;
    /// DSTD byte 2: the model-damage stage.
    damage_stage: ubyte;
    /// DSTD byte 3: 1 cap damage, 2 disable, 4 destroy, 8 ignore external damage.
    flags: ubyte;
    self_damage_per_second: int32;
    /// An Explosion in `explosions`, 0 if none.
    explosion: uint32;
    /// A debris form (DEBR, not in this file), 0 if none.
    debris: uint32;
    debris_count: int32;
    /// DMDL as a normalized virtual path, empty if the stage keeps the model.
    model: string;
}

/// One MODS entry (format 16): the shape named `shape` (3D index `index`, the
/// fallback when no shape has the name) of the base's model takes the texture
/// set's textures.
table AlternateTexture {
    shape: string;
    index: int32;
    /// The TXST's TX00..TX07 as normalized virtual paths (`textures/...`), in
    /// TXST order, empty for a slot the set does not fill. Always 8 entries.
    textures: [string];
}

/// MATO (format 10): a directional material (snow, sand, moss) projected
/// onto the up-facing parts of shapes with the Projected UV shader flag.
/// `model` is a NIF whose first shape's textures are the material's.
/// DATA (UESP, MATO record; Community Shaders' Lighting.hlsl for use):
/// falloff scale and bias, noise UV scale, material UV scale, projection
/// vector, normal dampener, single pass colour (0..1) and its flag.
table MaterialObject {
    id: uint32 (key);
    editor_id: string;
    model: string;
    falloff_scale: float;
    falloff_bias: float;
    noise_uv_scale: float;
    material_uv_scale: float;
    projection: [float];
    normal_dampener: float;
    single_pass_color: [float];
    single_pass: bool;
}

/// LTEX with its TXST resolved. Paths are normalized virtual paths.
table LandTexture {
    id: uint32 (key);
    editor_id: string;
    diffuse: string;
    normal: string;
    /// SNAM, 0..255.
    specular: ubyte;
    /// GNAM (format 10): Grass records growing on it.
    grasses: [uint32];
    /// INAM bit 0 (format 18): a snow texture; it does not compete for grass.
    snow: bool;
}

/// ADDN (format 10): the model the game attaches to a mesh's BSValueNode
/// "AddOnNode" whose value is `index` (mesh extras "addon").
table AddonNode {
    id: uint32 (key);
    editor_id: string;
    index: int32;
    model: string;
}

/// `Grass.flags`.
enum GrassFlags : ubyte (bit_flags) {
    vertex_lighting,
    uniform_scaling,
    fit_to_slope
}

/// GRAS (format 10; DATA, 32 bytes, UESP GRAS record). `model` is a
/// normalized virtual path. Slopes in degrees; distances in game units.
/// `water_type`: 0 above at least, 1 above at most, 2 below at least, 3 below
/// at most, 4 either at least, 5 either at most, 6 either at most above, 7
/// either at most below.
table Grass {
    id: uint32 (key);
    editor_id: string;
    model: string;
    density: ubyte;
    min_slope: ubyte;
    max_slope: ubyte;
    units_from_water: ushort;
    water_type: uint32;
    position_range: float;
    height_range: float;
    color_range: float;
    wave_period: float;
    flags: GrassFlags;
    /// Game units: half the diagonal of the object bounds (OBND), 0 without
    /// them. The game grows each grass on a grid of this size, at least
    /// iMinGrassSize (format 15).
    bound_radius: float;
}

/// One of WATR's three noise layers.
struct WaterLayer {
    /// Degrees.
    wind_direction: float;
    wind_speed: float;
    /// Game units per noise tile.
    uv_scale: float;
    amplitude: float;
}

/// WATR: the visual part of DNAM (source: UESP, WATR record; offsets checked
/// against Skyrim.esm). Colours are RGBA bytes, red in the low byte.
table Water {
    id: uint32 (key);
    editor_id: string;
    /// ANAM, 0..100.
    opacity: ubyte;
    /// FNAM bit 0: causes damage.
    flags: ubyte;
    shallow_color: uint32;
    deep_color: uint32;
    reflection_color: uint32;
    sun_specular_power: float;
    reflectivity: float;
    fresnel: float;
    fog_near: float;
    fog_far: float;
    specular_power: float;
    refraction_magnitude: float;
    reflection_magnitude: float;
    layers: [WaterLayer];
    /// NNAM (or NAM2..NAM4) noise textures as virtual paths.
    noise: [string];
    /// DNAM 132: above-water fog amount.
    fog_amount: float;
    /// DNAM 96.
    noise_falloff: float;
    /// DNAM 200.
    sun_sparkle_magnitude: float;
    /// DNAM 204.
    sun_specular_magnitude: float;
    /// DNAM 224.
    sun_sparkle_power: float;
    /// DNAM 208: depth control of reflections.
    depth_reflections: float;
    /// DNAM 212.
    depth_refraction: float;
    /// DNAM 216.
    depth_normals: float;
    /// DNAM 220.
    depth_specular: float;
}

struct ClimateWeather {
    /// A WTHR in `weathers`.
    weather: uint32;
    /// Out of 100.
    chance: int;
}

/// CLMT. Times are hours (TNAM stores 10-minute steps).
table Climate {
    id: uint32 (key);
    editor_id: string;
    weathers: [ClimateWeather];
    sunrise_begin: float;
    sunrise_end: float;
    sunset_begin: float;
    sunset_end: float;
    /// FNAM, GNAM: virtual paths.
    sun_texture: string;
    sun_glare_texture: string;
    /// MODL: the night sky's model (stars), a virtual path.
    sky: string;
    /// TNAM.
    volatility: ubyte;
    /// Bit 0 Masser, bit 1 Secunda.
    moons: ubyte;
    /// Days per moon phase.
    phase_length: ubyte;
}

/// One cloud layer of a weather. Layer i is drawn on the i-th shape of
/// meshes/sky/clouds.nif (29 shapes, 29 layers).
table CloudLayer {
    /// A virtual path, or empty.
    texture: string;
    /// QNAM, RNAM: the stored byte minus 127, over 127 (-1..1). Units not
    /// known; 0 is still.
    speed_x: float;
    speed_y: float;
    /// PNAM: RGBA by time of day (sunrise, day, sunset, night), red in the
    /// low byte.
    colors: [uint];
    /// JNAM: by time of day.
    alphas: [float];
    /// Has a texture and its NAM1 bit is clear.
    enabled: bool;
}

/// SPGD: rain or snow particles.
table Precipitation {
    id: uint32 (key);
    editor_id: string;
    /// ICON, a virtual path: an atlas of subtextures_x by subtextures_y.
    texture: string;
    /// Game units per second, downwards.
    gravity_velocity: float;
    rotation_velocity: float;
    size_x: float;
    size_y: float;
    center_offset_min: float;
    center_offset_max: float;
    /// Degrees.
    rotation_range: float;
    subtextures_x: uint32;
    subtextures_y: uint32;
    /// 0 rain, 1 snow.
    type: ubyte;
    /// Game units; 0 if not given.
    box_size: uint32;
    /// 0 if not given.
    density: float;
}

/// A weather a region offers, as CLMT's list plus RDWT's gating global.
struct RegionWeather {
    weather: uint32;
    chance: int;
    global: uint32;
}

/// RPLD: a region polygon, x and y in game units.
table RegionArea {
    points: [float];
}

/// REGN with a weather list (RDAT type 3). Where its areas cover the
/// player, the region with the highest priority picks the weather.
table Region {
    id: uint32 (key);
    editor_id: string;
    world: uint32;
    areas: [RegionArea];
    weathers: [RegionWeather];
    weather_priority: ubyte;
    /// RDAT flags bit 0.
    weather_override: bool;
}

/// `Weather.classification`.
enum WeatherClass : ubyte (bit_flags) {
    pleasant,
    cloudy,
    rainy,
    snow,
    sky_statics_always_visible,
    sky_statics_follow_sun
}

/// WTHR, the parts that light a scene. Times of day are sunrise, day,
/// sunset, night, in that order. Colours are RGBA bytes, red in the low byte.
table Weather {
    id: uint32 (key);
    editor_id: string;
    /// NAM0: 17 colours x 4 times, index colour * 4 + time. Colours in order:
    /// sky upper, fog near, unknown, ambient, sunlight, sun, stars, sky lower,
    /// horizon, effect lighting, cloud LOD diffuse, cloud LOD ambient, fog
    /// far, sky statics, water multiplier, sun glare, moon glare.
    colors: [uint];
    /// FNAM: day near, day far, night near, night far, day power, night
    /// power, day max, night max. Distances in game units.
    fog: [float];
    /// DALC: per time, x+, x-, y+, y-, z+, z- and specular (7 x 4).
    directional_ambient: [uint];
    clouds: [CloudLayer];
    /// DATA, stored as bytes; fractions are byte / 255.
    wind_speed: float;
    /// Degrees.
    wind_direction: float;
    wind_direction_range: float;
    transition_delta: float;
    sun_glare: float;
    sun_damage: float;
    /// Points of a transition where precipitation starts to fade in and
    /// finishes fading out.
    precipitation_begin: float;
    precipitation_end: float;
    thunder_begin: float;
    thunder_end: float;
    thunder_frequency: float;
    classification: WeatherClass;
    /// RGB, red in the low byte.
    lightning_color: uint;
    /// MNAM, a Precipitation; 0 if none.
    precipitation: uint32;
    /// MODL: the aurora, a virtual path.
    aurora: string;
    /// IMSP (format 10): an ImageSpace per time of day (sunrise, day,
    /// sunset, night); 0 where none.
    image_spaces: [uint32];
    /// HNAM (format 13): a VolumetricLighting per time of day (sunrise, day,
    /// sunset, night); 0 where none.
    volumetric_lighting: [uint32];
}

/// VOLI (format 13, Update.esm only): volumetric lighting. The floats are the
/// subrecords as they are: CNAM `intensity`, DNAM `custom_color_contribution`,
/// ENAM/FNAM/GNAM the custom colour (0..1), and the rest. The engine uses
/// intensity, custom colour and its contribution only; the density, phase
/// function and range factor fields are stored but unused.
table VolumetricLighting {
    id: uint32 (key);
    editor_id: string;
    intensity: float;
    custom_color_contribution: float;
    red: float;
    green: float;
    blue: float;
    /// Unused by the engine.
    density_contribution: float;
    density_size: float;
    density_wind_speed: float;
    density_falling_speed: float;
    phase_contribution: float;
    phase_scattering: float;
    sampling_range_factor: float;
}

/// IMGS (format 10): colour grading after lighting. `hdr` is HNAM's nine
/// floats: eye adapt speed, bloom blur radius, bloom threshold, bloom scale,
/// receive bloom threshold, white, sunlight scale, sky scale, eye adapt
/// strength. `cinematic` is CNAM: saturation, brightness, contrast. `tint`
/// is TNAM: amount, red, green, blue. Empty where the record has none.
table ImageSpace {
    id: uint32 (key);
    editor_id: string;
    hdr: [float];
    cinematic: [float];
    tint: [float];
}

/// `Worldspace.parent_flags`: PNAM, which properties come from the parent.
enum ParentFlags : uint16 (bit_flags) {
    land_data
}

/// A reference drawn as a large reference (format 11): one of the worldspace's
/// RNAM entries (the Creation Kit's list of references whose bounds exceed
/// fLargeRefMinSize), with its placement as `Ref` has it so the engine need
/// not find the reference in its cell. Only the winning record's references
/// are here: a deleted reference, one that is initially disabled, one whose
/// cell or worldspace is not the worldspace's, and one not found are left out.
/// Its enable parent (and `enable_opposite`) is kept for the engine to
/// evaluate; `flags` is `Ref.flags`.
struct LargeRef {
    id: uint32 (key);
    base: uint32;
    position: Vec3f;
    rotation: Vec3f;
    scale: float;
    flags: RefFlags;
    enable_parent: uint32;
    /// The cell the reference stands in (RNAM's entry cell).
    cell_x: short;
    cell_y: short;
}

/// The large references of one cell of the large-reference grid: the
/// `count` entries of `Worldspace.large_cell_refs` from `first`. A cell's
/// list holds the references that stand in it and those of its neighbours
/// whose bounds reach into it, so drawing the lists of the cells in range,
/// each reference once, draws everything that is visible there.
struct LargeRefCell {
    cell_x: short;
    cell_y: short;
    first: uint32;
    count: uint32;
}

/// WRLD.
table Worldspace {
    id: uint32 (key);
    editor_id: string;
    /// WNAM; 0 if none.
    parent: uint32;
    /// PNAM.
    parent_flags: ParentFlags;
    /// DATA flags.
    flags: ubyte;
    /// DNAM; the land and water height of cells without LAND or XCLW.
    has_defaults: bool;
    default_land_height: float;
    default_water_height: float;
    /// NAM2, a WATR; 0 if none.
    water: uint32;
    /// CNAM, a CLMT in `climates`; 0 if none.
    climate: uint32;
    /// NAM0 / NAM9: bounds in game units.
    min_x: float;
    min_y: float;
    max_x: float;
    max_y: float;
    /// RNAM (format 11): the worldspace's large references, sorted by id, and
    /// their lists per cell, sorted by cell_y then cell_x. Every cell has at
    /// least one reference. `large_cell_refs` holds indices into `large_refs`,
    /// ascending within a cell's range. Empty for a worldspace with none.
    large_refs: [LargeRef];
    large_cells: [LargeRefCell];
    large_cell_refs: [uint32];
    /// FULL (format 25): the name a load door into the worldspace shows; empty if none.
    name: string;
}

/// `QuestLogEntry.flags`.
enum LogEntryFlags : ubyte (bit_flags) {
    completes_quest,
    fails_quest
}

/// A journal entry of a quest stage (QSDT, CNAM).
table QuestLogEntry {
    flags: LogEntryFlags;
    text: string;
    /// CTDA count. Conditions choose among a stage's entries; the engine does
    /// not evaluate them.
    conditions: ushort;
    /// The CTDAs counted by `conditions` (format 26): the entry is chosen when
    /// the stage is set if they pass.
    condition_list: [Condition];
}

/// `QuestStage.flags`.
enum StageFlags : ubyte (bit_flags) {
    start_up = 1,
    shut_down
}

table QuestStage {
    index: ushort;
    /// INDX.
    flags: StageFlags;
    log: [QuestLogEntry];
}

/// QOBJ with its FNAM, NNAM and QSTA.
table QuestObjective {
    index: ushort;
    /// Bit 0: ORed with the previous objective.
    flags: uint32;
    text: string;
    /// The aliases the compass points at.
    targets: [int];
}

/// A stage fragment: `function` of the quest's fragment script runs when
/// `stage` is set and its log entry `log_entry` is the one chosen.
table QuestFragment {
    stage: ushort;
    log_entry: int;
    function: string;
}

/// `QuestAlias.flags`: FNAM (source: UESP, QUST record).
enum AliasFlags : uint32 (bit_flags) {
    optional = 1,
    allow_disabled = 7,
    initially_disabled = 15
}

/// A quest alias, in the order the quest fills them. How it is filled is the
/// first that applies: `forced` (ALFR, or ALFL for a location alias),
/// `unique_actor`, `external_quest`/`external_alias`, `created_object` at
/// alias `create_at`; otherwise conditions pick it ("find matching"), which
/// the engine does not evaluate.
table QuestAlias {
    id: uint32;
    name: string;
    /// A location alias (ALLS) rather than a reference alias (ALST).
    location: bool;
    flags: AliasFlags;
    forced: uint32;
    /// An NPC_; the alias takes its one placed actor.
    unique_actor: uint32;
    external_quest: uint32;
    external_alias: int = -1;
    created_object: uint32;
    /// ALCA, low 16 bits: the alias to create at.
    create_at: uint32;
    /// CTDA count.
    conditions: ushort;
    /// ALDN, a MESG.
    display_name: uint32;
    /// Scripts attached to the alias (from the quest's VMAD).
    scripts: [Script];
    /// The CTDAs counted by `conditions` (format 26): they choose the fill of
    /// an alias that nothing names.
    condition_list: [Condition];
}

/// `Quest.flags`: DNAM (source: UESP, QUST record).
enum QuestFlags : uint16 (bit_flags) {
    start_game_enabled,
    allow_repeated_stages = 3,
    run_once = 8
}

/// QUST.
table Quest {
    id: uint32 (key);
    editor_id: string;
    name: string;
    flags: QuestFlags;
    priority: ubyte;
    type: uint32;
    /// ENAM: the story manager event as a four-character code, or 0.
    event: uint32;
    scripts: [Script];
    /// The script holding the stage fragments.
    fragment_script: string;
    /// Sorted by stage, then log entry.
    fragments: [QuestFragment];
    /// Sorted by index.
    stages: [QuestStage];
    /// In record order.
    objectives: [QuestObjective];
    aliases: [QuestAlias];
    /// The CTDAs before NEXT (format 26): they gate every dialogue INFO of the
    /// quest.
    dialogue_conditions: [Condition];
    /// The CTDAs after NEXT and before the first INDX (format 26): the
    /// conditions of the quest's story manager event.
    event_conditions: [Condition];
}

/// GLOB. `kind` is FNAM: 's' short, 'l' long, 'f' float.
table Global {
    id: uint32 (key);
    editor_id: string;
    kind: ubyte;
    value: float;
}

/// A placed actor (ACHR). Not built yet; quest aliases name them.
struct ActorRef {
    ref: uint32 (key);
    /// The NPC_.
    base: uint32;
    cell: uint32;
    position: Vec3f;
    rotation: Vec3f;
    flags: RefFlags;
}

/// One sex's body part of a race (RACE NAM1 section): INDX 0 upper body,
/// 1 lower body, 2 hand, 3 foot, 4 tail.
table RaceBodyPart {
    female: bool;
    index: uint32;
    model: string;
}

/// RACE: what an actor of this race is built from. Paths are normalized
/// virtual paths. Per-sex vectors hold male, then female.
table Race {
    id: uint32 (key);
    editor_id: string;
    /// ANAM: the skeleton NIF; its animation skeleton is the `.hkx` of the
    /// same name beside it.
    skeletons: [string];
    /// The behaviour graph (`.hkx`) per sex.
    behaviours: [string];
    /// WNAM: the ARMO worn when naked (body, hands, feet).
    skin: uint32;
    heights: [float];
    weights: [float];
    /// DATA flags: 1 playable, 2 FaceGen head, 4 child, …
    flags: uint32;
    body_parts: [RaceBodyPart];
    /// HEAD in the head data section, male then female in `head_parts_female`.
    head_parts_male: [uint32];
    head_parts_female: [uint32];
    /// RNAM: the race whose armor this one wears.
    armor_race: uint32;
    /// DATA skill boosts (format 24): seven pairs, `skill_boosts` holding
    /// the actor value index (6 One-handed ... 23 Enchanting, 255 none) and
    /// then the boost, interleaved: 14 bytes.
    skill_boosts: [ubyte];
    /// DATA starting values (format 24): bytes 36, 40, 44.
    start_health: float;
    start_magicka: float;
    start_stamina: float;
    /// DATA base carry weight (format 24): byte 48.
    carry_weight: float;
    /// DATA regeneration per second in percent of the maximum (format 24):
    /// bytes 84, 88, 92.
    health_regen: float;
    magicka_regen: float;
    stamina_regen: float;
    /// VTCK (format 26): the voice types of the male and the female, VTYP ids;
    /// empty or 0 if none.
    voice_types: [uint32];
    /// DATA (format 30): bytes 96 and 100, the unarmed damage and reach.
    unarmed_damage: float;
    unarmed_reach: float;
    /// NAM4 (a MaterialType, MATT) and NAM5 (an ImpactDataSet in
    /// `impact_data_sets`) (format 30); 0 if none.
    impact_material: uint32;
    impact_data_set: uint32;
    /// ATKD and ATKE pairs (format 30), in record order.
    attacks: [RaceAttack];
}

/// RACE ATKD (44 bytes) and ATKE (format 30). Source: xEdit's RACE layout. In
/// vanilla data a standing power attack has `damage_mult` 2.
table RaceAttack {
    /// ATKE: the animation event, e.g. `attackStart`, `attackPowerStartForward`.
    event: string;
    damage_mult: float;
    chance: float;
    /// A Spell; 0 if none.
    spell: uint32;
    /// Raw ATKD flags: 0x1 ignore weapon, 0x2 bash attack, 0x4 power attack,
    /// 0x8 left attack, 0x10 rotating attack, 0x20 override damage.
    flags: uint32;
    attack_angle: float;
    strike_angle: float;
    stagger: float;
    /// A Keyword; 0 if none.
    attack_type: uint32;
    knockdown: float;
    recovery_time: float;
    stamina_mult: float;
}

/// ARMO: an item worn. Bit n of `slots` is body slot 30 + n.
table Armor {
    id: uint32 (key);
    editor_id: string;
    slots: uint32;
    race: uint32;
    /// The ARMA that render it, in order.
    addons: [uint32];
}

/// ARMA: one race's model of an armor. Weight slider bit 1 (2) means the
/// model has `_0` (thin) and `_1` (heavy) variants; the path names `_1`.
table ArmorAddon {
    id: uint32 (key);
    editor_id: string;
    slots: uint32;
    race: uint32;
    additional_races: [uint32];
    male_model: string;
    female_model: string;
    male_priority: ubyte;
    female_priority: ubyte;
    male_weight_slider: ubyte;
    female_weight_slider: ubyte;
    /// MOD4 and MOD5 (format 30): the first-person models; empty if none.
    male_model_1st: string;
    female_model_1st: string;
}

/// OTFT: ARMO and LVLI.
table Outfit {
    id: uint32 (key);
    items: [uint32];
}

struct LeveledEntry {
    level: uint16;
    count: uint16;
    form: uint32;
}

/// `LeveledList.flags`: LVLF.
enum LeveledListFlags : ubyte (bit_flags) {
    from_all_levels,
    /// LVLI only.
    each_entry,
    use_all
}

/// LVLI, LVLN or LVSP (format 28).
table LeveledList {
    id: uint32 (key);
    type: uint32;
    flags: LeveledListFlags;
    chance_none: ubyte;
    entries: [LeveledEntry];
    /// LVLG (format 28): a GlobalVariable whose value replaces `chance_none`;
    /// 0 if none.
    chance_global: uint32;
}

struct NpcItem {
    form: uint32;
    count: int32;
}

/// SNAM: a faction an NPC belongs to, and its rank there.
struct NpcFaction {
    faction: uint32;
    rank: int;
}

/// `Npc.flags`: ACBS flags.
enum NpcFlags : uint32 (bit_flags) {
    female,
    essential,
    /// The stats are the CK's computed totals (format 24 names it).
    auto_calc_stats = 4,
    unique = 5,
    /// The level word is a multiplier (format 24 names it): the actor
    /// levels with the player.
    pc_level_mult = 7
}

/// `Npc.template_flags`: which parts of an actor come from its template
/// (ACBS template flags; source: xEdit, wbTemplateFlags).
enum NpcTemplateFlags : uint16 (bit_flags) {
    use_traits,
    /// Level, health, magicka, stamina and skills (named in format 24).
    use_stats,
    use_factions = 2,
    /// AIDT: aggression, confidence, energy, morality, mood, assistance.
    use_ai_data = 4,
    use_ai_packages = 5,
    use_inventory = 8,
    /// DPLT's default package list.
    use_package_list = 10
}

/// NPC_: what an actor base looks like and wears.
table Npc {
    id: uint32 (key);
    editor_id: string;
    name: string;
    flags: NpcFlags;
    level: uint16;
    race: uint32;
    /// TPLT (an NPC_ or LVLN) and which parts come from it.
    template: uint32;
    template_flags: NpcTemplateFlags;
    /// WNAM: overrides the race's skin.
    skin: uint32;
    default_outfit: uint32;
    sleeping_outfit: uint32;
    height: float;
    weight: float;
    head_parts: [uint32];
    items: [NpcItem];
    /// The FaceGen head the game precomputes for this NPC
    /// (`meshes/actors/character/facegendata/facegeom/<plugin>/<id>.nif`,
    /// named by the plugin that defines it), whether or not it exists.
    face_model: string;
    /// QNAM: the skin tone the SkinTint shader multiplies body skin by, RGB
    /// 0-1. Absent in packs written before it was added: no tint.
    skin_tone: [float];
    /// PKID, in priority order (format 9).
    packages: [uint32];
    /// DPLT's FLST, expanded: tried after `packages`.
    default_packages: [uint32];
    /// SNAM, in record order (format 9).
    factions: [NpcFaction];
    /// ACBS (format 24): the offsets are signed. `flags` carries the whole
    /// ACBS flag word.
    health_offset: int16;
    magicka_offset: int16;
    stamina_offset: int16;
    calc_min_level: uint16;
    calc_max_level: uint16;
    /// Percent; 100 is normal speed.
    speed_multiplier: uint16;
    /// DNAM (format 24): the derived stats and the 18 skills (actor value
    /// 6 + index) with their offsets.
    health: uint16;
    magicka: uint16;
    stamina: uint16;
    skill_values: [ubyte];
    skill_offsets: [ubyte];
    /// AIDT (format 24).
    aggression: ubyte;
    confidence: ubyte;
    energy: ubyte;
    morality: ubyte;
    mood: ubyte;
    assistance: ubyte;
    /// VTCK (format 26): a VTYP in `voice_types`; 0 if none.
    voice_type: uint32;
    /// KWDA (format 26): KYWD ids.
    keywords: [uint32];
}

/// The low bits of `Condition.type`.
enum ConditionFlags : ubyte (bit_flags) {
    /// OR with the next condition.
    or_next,
    use_aliases,
    /// Compare with the GLOB `value_global`.
    use_global,
    use_package_data,
    /// Swap subject and target.
    swap_subject_target
}

/// A CTDA condition. FormID parameters (by the function's parameter types)
/// are global; everything else is raw. Source: xEdit's wbConditions; see
/// `bethconv/record/conditions.hpp` for the function table.
table Condition {
    /// The comparison in the top three bits (0 ==, 1 !=, 2 >, 3 >=, 4 <,
    /// 5 <=) and `ConditionFlags` below them. A plain byte, not the enum: it
    /// holds a number too.
    type: ubyte;
    function: ushort;
    value: float;
    value_global: uint32;
    param1: uint32;
    param2: uint32;
    /// 0 subject, 1 target, 2 `reference`, 3 combat target, 4 linked
    /// reference, 5 quest alias `param3`, 6 package data, 7 event data.
    run_on: uint32;
    reference: uint32;
    param3: int = -1;
    /// CIS1/CIS2: string parameters (variable names).
    string1: string;
    string2: string;
}

/// One data input of a package, matched to the template's by `key`.
table PackageInput {
    key: byte;
    /// Bool, Int, Float, Location, SingleRef, TargetSelector, ObjectList,
    /// Topic, Keyword, …
    type: string;
    /// The template's name for it (BNAM after the tree), on templates.
    name: string;
    /// Bool (0 or 1), Int and Float values.
    number: float;
    /// PLDT, for Location: 0 near reference, 1 in cell, 2 near package start,
    /// 3 near editor location, 4 object id, 5 object type, 6 near linked
    /// reference (value: a keyword or 0), 7 at package location, 8 reference
    /// alias, 9 location alias, 12 near self. -1 if absent. Value is global
    /// for 0, 1, 4 and 6.
    location_type: int = -1;
    location_value: uint32;
    location_radius: int;
    /// PTDA, for SingleRef and TargetSelector: 0 specific reference, 1 object
    /// id, 2 object type, 3 linked reference (value: a keyword or 0), 4
    /// reference alias, 6 self. -1 if absent. Value is global for 0, 1 and 3.
    target_type: int = -1;
    target_value: uint32;
    target_count: int;
}

/// `PackageBranch.flags`: PRCB flags.
enum BranchFlags : uint32 (bit_flags) {
    repeat_when_complete
}

/// A node of a template's procedure tree, in pre-order: a node with
/// `children` > 0 (Sequence, Stack, Simultaneous, Random, …) is followed by
/// that many subtrees; a `Procedure` node is a leaf running `procedure`.
table PackageBranch {
    type: string;
    conditions: [Condition];
    children: uint32;
    flags: BranchFlags;
    procedure: string;
    success_completes: bool;
    /// The data input keys the procedure reads, in its own parameter order.
    inputs: [ubyte];
    /// PFO2: flags set and cleared while it runs, and a speed (-1 none).
    set_flags: uint32;
    clear_flags: uint32;
    speed: byte = -1;
}

/// `Package.flags`: PKDT general flags (source: xEdit, wbPackageFlags).
enum PackageFlags : uint32 (bit_flags) {
    must_complete = 2,
    unlock_doors_at_start = 6,
    unlock_doors_at_end,
    once_per_day = 10,
    preferred_speed = 13,
    wear_sleep_outfit = 29
}

/// PACK: an AI package (type 18) or a template (19). A package runs its
/// template's `branches` with the template's `inputs` overridden by its own,
/// by key.
table Package {
    id: uint32 (key);
    editor_id: string;
    type: ubyte;
    flags: PackageFlags;
    interrupt_override: ubyte;
    /// 0 walk, 1 jog, 2 run, 3 fast walk.
    speed: ubyte;
    interrupt_flags: ushort;
    /// PSDT: -1 any (`date` 0 any). Day of week 0 Sunday … 6 Saturday, 7
    /// weekdays, 8 weekends, 9 Monday/Wednesday/Friday, 10 Tuesday/Thursday.
    month: byte = -1;
    day_of_week: byte = -1;
    date: byte;
    hour: byte = -1;
    minute: byte = -1;
    /// Minutes.
    duration: uint32;
    conditions: [Condition];
    template: uint32;
    inputs: [PackageInput];
    branches: [PackageBranch];
    idle_flags: ubyte;
    idle_timer: float;
    idles: [uint32];
    owner_quest: uint32;
    combat_style: uint32;
    on_begin_idle: uint32;
    on_end_idle: uint32;
    on_change_idle: uint32;
}

/// A plugin of the load order and where its forms live: a form of this
/// plugin with object id `n` is `prefix | n`, `n` masked to 24 bits (12 for a
/// light plugin). For Game.GetFormFromFile.
/// AMMO (format 19): what a fired weapon launches. The model is the base of
/// the same id in `bases`.
table Ammo {
    id: uint32 (key);
    /// The PROJ in `projectiles`.
    projectile: uint32;
    /// DATA flags: bit 0 ignores normal weapon resistance, 1 non-playable,
    /// 2 non-bolt (arrow).
    flags: uint32;
}

/// PROJ (format 19): flight data from DATA. The model is the base of the same
/// id in `bases`.
table Projectile {
    id: uint32 (key);
    /// 1 missile, 2 lobber, 4 beam, 8 flame, 0x10 cone, 0x20 barrier, 0x40 arrow.
    type: uint16;
    flags: uint16;
    /// Multiplier of the world's gravity.
    gravity: float;
    /// Game units per second.
    speed: float;
    /// Game units.
    range: float;
    /// Game units.
    collision_radius: float;
    /// Seconds.
    lifetime: float;
    /// NAM1: the model shown at the muzzle when flag 0x8 is set (format 20).
    muzzle_flash_model: string;
    /// Seconds the muzzle flash lasts, DATA offset 44 (format 20).
    muzzle_flash_duration: float;
}

table Plugin {
    name: string;
    prefix: uint32;
    light: bool;
}

/// SNDR (format 21): a sound descriptor. `files` are normalized virtual paths
/// of sound assets (`sound/fx/...`), in ANAM order; the engine plays a random
/// one. Layouts checked against Skyrim.esm: CNAM is the descriptor type
/// (0x1EEF540A standard; anything else is compound and has no files of its
/// own), GNAM the category (SNCT), ONAM the output model (SOPM), LNAM four
/// bytes of which byte 1 is the looping type, BNAM six bytes.
table SoundDescriptor {
    id: uint32 (key);
    editor_id: string;
    files: [string];
    /// The SOPM in `sound_output_models`, 0 if none.
    output_model: uint32;
    category: uint32;
    /// CNAM as stored.
    descriptor_type: uint32;
    /// LNAM byte 1: 0 none, 0x08 loop, 0x10 envelope fast, 0x20 envelope slow.
    looping: uint8;
    /// BNAM: percent frequency shift and variance, priority, dB variance,
    /// static attenuation in hundredths of a dB.
    frequency_shift: int8;
    frequency_variance: int8;
    priority: uint8;
    db_variance: uint8;
    static_attenuation: uint16;
}

/// SOUN (format 21): a sound marker, placed in cells (ambient loops).
table SoundMarker {
    id: uint32 (key);
    editor_id: string;
    /// SDSC: the SNDR in `sound_descriptors`.
    descriptor: uint32;
}

/// SOPM (format 21): how a sound is placed in space. NAM1 byte 0 holds the
/// flags (bit 0 attenuates with distance); MNAM is the type (0 positional,
/// 1 defined speaker output); ANAM is 4 reserved bytes, min and max distance
/// as floats in game units, five curve bytes (percent volume at evenly
/// spaced distances) and 3 reserved bytes.
table SoundOutputModel {
    id: uint32 (key);
    editor_id: string;
    flags: uint8;
    type: uint32;
    min_distance: float;
    max_distance: float;
    curve: [ubyte];
}

/// KYWD (format 22): `Keyword.GetKeyword` finds one by editor id.
table Keyword {
    id: uint32 (key);
    editor_id: string;
}

/// FLST (format 22): the forms of LNAM, as global ids, in order.
table FormList {
    id: uint32 (key);
    editor_id: string;
    forms: [uint32];
}

/// `Message.flags` (MESG DNAM).
enum MessageFlags : uint32 (bit_flags) {
    message_box,
    auto_display
}

/// MESG (format 22): `title` is FULL, `text` DESC (localized strings,
/// resolved), `buttons` the ITXT of each button in order. A message with
/// the message_box flag is shown as a box with buttons, else as a notification.
table Message {
    id: uint32 (key);
    editor_id: string;
    title: string;
    text: string;
    flags: MessageFlags;
    buttons: [string];
}

/// EXPL (format 23); DATA is 52 bytes: light, sound 1 (inside the radius),
/// sound 2, impact data set, placed object, spawn projectile, force, damage,
/// radius, image space radius, vertical offset multiplier, flags, sound level.
/// All forms are global ids; 0 if none. An explosion is also a `bases` entry,
/// so references to it resolve.
table Explosion {
    id: uint32 (key);
    editor_id: string;
    /// Normalized virtual path, or empty.
    model: string;
    light: uint32;
    sound: uint32;
    sound_far: uint32;
    impact_data: uint32;
    placed_object: uint32;
    projectile: uint32;
    force: float;
    damage: float;
    radius: float;
    flags: uint32;
}

/// GMST (format 30). Sorted in `World.gmsts` by the ASCII lower-case
/// `editor_id`, so a lookup is a binary search.
enum GameSettingKind : ubyte {
    floating,
    integer,
    boolean,
    text
}

table GameSetting {
    editor_id: string;
    kind: GameSettingKind;
    /// The value of a `floating` setting.
    float_value: float;
    /// The value of an `integer` (an unsigned `u` setting too, bit for bit)
    /// or `boolean` (0 or 1) setting.
    int_value: int32;
    /// The value of a `text` setting, localized.
    text_value: string;
}

struct ImpactEntry {
    /// A MaterialType (MATT).
    material: uint32;
    /// An Impact in `impacts`.
    impact: uint32;
}

/// IPDS (format 30): the impact each material takes. PNAM pairs.
table ImpactDataSet {
    id: uint32 (key);
    editor_id: string;
    entries: [ImpactEntry];
}

/// IPCT (format 30): what a hit leaves. Sources: xEdit's IPCT layout.
table Impact {
    id: uint32 (key);
    editor_id: string;
    /// MODL: normalized virtual path, or empty.
    model: string;
    /// DATA: the effect duration in seconds.
    duration: float;
    /// DATA: 0 surface normal, 1 projectile vector, 2 projectile reflection.
    orientation: uint32;
    angle_threshold: float;
    placement_radius: float;
    /// DATA: bit 0 no decal data.
    flags: ubyte;
    /// SNAM and NAM1: SoundDescriptors; 0 if none.
    sound1: uint32;
    sound2: uint32;
    /// NAM2: a Hazard; 0 if none.
    hazard: uint32;
}

/// `DialogueBranch.flags`: DLBR DNAM (format 26; source: UESP).
enum DialogueBranchFlags : uint32 (bit_flags) {
    top_level,
    blocking,
    exclusive
}

/// DLBR (format 26): a branch of a quest's dialogue.
table DialogueBranch {
    id: uint32 (key);
    editor_id: string;
    /// QNAM, a Quest.
    quest: uint32;
    /// SNAM, a DialogueTopic.
    start_topic: uint32;
    flags: DialogueBranchFlags;
    /// TNAM: 0 player, 1 command.
    category: uint32;
}

/// `DialogueTopic.flags`: DIAL DATA byte 0 (format 26).
enum DialogueTopicFlags : ubyte (bit_flags) {
    do_all_before_repeating
}

/// `DialogueInfo.flags`: INFO ENAM low word (format 26; source: UESP, xEdit).
enum DialogueInfoFlags : uint16 (bit_flags) {
    goodbye,
    random,
    say_once,
    requires_player_activation,
    info_refusal,
    random_end,
    invisible_continue,
    walk_away,
    walk_away_invisible_in_menu,
    force_subtitle,
    can_move_while_greeting,
    no_lip_file,
    requires_post_processing,
    audio_output_override,
    spends_favor_points
}

/// One spoken response of a line: TRDT with NAM1 and NAM2 (format 26).
table DialogueResponse {
    /// TRDT bytes 0 and 4: the emotion type (0 neutral ... 7 surprise) and
    /// its value.
    emotion: uint32;
    emotion_value: uint32;
    /// TRDT byte 12: the response number; it names the voice file.
    number: ubyte;
    /// TRDT bytes 16: a SoundDescriptor; 0 if none.
    sound: uint32;
    /// TRDT byte 20: 1 use emotion animation.
    flags: ubyte;
    /// NAM1, resolved from the ILSTRINGS table.
    text: string;
    /// NAM2: the writer's notes.
    notes: string;
}

/// INFO (format 26): one line of a topic. FormIDs are global.
table DialogueInfo {
    id: uint32;
    editor_id: string;
    flags: DialogueInfoFlags;
    /// ENAM high word.
    reset_hours: uint16;
    /// CNAM.
    favor_level: ubyte;
    /// RNAM: the text the player's menu shows instead of the topic's.
    prompt: string;
    /// ANAM, an NPC_.
    speaker: uint32;
    /// DNAM, an INFO whose responses this one uses.
    shared_info: uint32;
    /// TCLT, topics, in order.
    links: [uint32];
    /// TWAT, a topic.
    walk_away_topic: uint32;
    /// ONAM, a SOPM.
    audio_output: uint32;
    conditions: [Condition];
    responses: [DialogueResponse];
    /// VMAD scripts.
    scripts: [Script];
    /// INFO VMAD fragments: the TIF__ script file and the functions of its
    /// begin and end fragments (`Fragment_N(ObjectReference akSpeakerRef)`);
    /// empty if absent.
    fragment_script: string;
    begin_fragment: string;
    end_fragment: string;
}

/// DIAL (format 26): a topic.
table DialogueTopic {
    id: uint32 (key);
    editor_id: string;
    /// FULL: the player's line.
    text: string;
    quest: uint32;
    /// BNAM, a DialogueBranch.
    branch: uint32;
    /// PNAM.
    priority: float;
    flags: DialogueTopicFlags;
    /// DATA byte 1.
    category: ubyte;
    /// DATA bytes 2 and 3.
    subtype: uint16;
    /// SNAM: GREE, HELO, IDLE, ... as four characters (like `Quest.event`).
    subtype_code: uint32;
    /// The INFOs in group order (the Creation Kit's order); overrides keep the
    /// base plugin's place, new ones follow in the order of the plugin that
    /// adds them.
    infos: [DialogueInfo];
}

/// VTYP (format 26). `flags` is DNAM: 1 allow default dialogue, 2 female.
table VoiceType {
    id: uint32 (key);
    editor_id: string;
    flags: ubyte;
}

/// LCTN (format 26).
table Location {
    id: uint32 (key);
    editor_id: string;
    name: string;
    /// PNAM, a Location.
    parent: uint32;
    /// KWDA, KYWD ids.
    keywords: [uint32];
}

/// RELA (format 26): DATA is 16 bytes, parent NPC, child NPC, rank (u16), two
/// bytes, association type (an ASTP).
table Relationship {
    id: uint32 (key);
    editor_id: string;
    parent: uint32;
    child: uint32;
    /// As stored; xEdit's names: 0 lover, 1 ally, 2 confidant, 3 friend, 4
    /// acquaintance, 5 rival, 6 foe, 7 enemy, 8 archnemesis.
    rank: uint16;
    association: uint32;
}

/// `Faction.flags` bits the engine names (FACT DATA).
enum FactionFlags : uint32 (bit_flags) {
    hidden_from_pc,
    vendor = 14
}

/// FACT (format 26): what conditions and vendors read.
table Faction {
    id: uint32 (key);
    editor_id: string;
    /// DATA.
    flags: FactionFlags;
    /// VENV: the hours (0-24) and the radius a vendor of this faction trades in.
    vendor_start_hour: uint16;
    vendor_end_hour: uint16;
    vendor_radius: uint32;
    /// VENC, a container.
    vendor_chest: uint32;
}

/// `Scene.flags`: SCEN FNAM (format 27; source: UESP, xEdit).
enum SceneFlags : uint32 (bit_flags) {
    /// Begin when the quest starts.
    begin_on_quest_start,
    /// Stop when the quest ends.
    stop_on_quest_end,
    show_all_text = 2,
    repeat_while_true,
    interruptible
}

/// One phase of a scene, in order; its index is its position.
table ScenePhase {
    /// NAM0.
    name: string;
    /// The conditions before the first NEXT: the phase is skipped if they fail.
    start_conditions: [Condition];
    /// The conditions after it: the phase waits for them.
    completion_conditions: [Condition];
}

/// An actor of a scene, filled from the quest alias `alias`.
table SceneActor {
    /// ALID.
    alias: int;
    /// LNAM.
    flags: uint32;
    /// DNAM: behaviour flags (Skyrim.esm uses 0x1a on both Riverwood
    /// actors).
    behaviour_flags: uint32;
}

/// One action of a scene. There are no conditions on actions in SSE.
table SceneAction {
    /// ANAM: 0 dialogue, 1 package, 2 timer.
    type: ushort;
    /// NAM0.
    name: string;
    /// ALID: the acting alias; -1 if none (timers).
    alias: int;
    /// INAM.
    index: uint32;
    /// FNAM (dialogue actions only).
    flags: uint32;
    /// SNAM: the phase whose start starts the action.
    start_phase: uint32;
    /// ENAM: the phase the action must be done for.
    end_phase: uint32;
    /// DATA, a DialogueTopic (dialogue).
    topic: uint32;
    /// PNAM, packages (package).
    packages: [uint32];
    /// The second SNAM (timer).
    timer_seconds: float;
    /// HTID: the alias to look at; -1 none.
    head_track_alias: int = -1;
    /// DMAX and DMIN.
    delay_max: float;
    delay_min: float;
    /// DEMO and DEVA.
    emotion: uint32;
    emotion_value: uint32;
}

/// SCEN (format 27): a scene, FormIDs global. Old-style result scripts and
/// VNAM are not kept.
table Scene {
    id: uint32 (key);
    editor_id: string;
    /// The PNAM after the last action.
    quest: uint32;
    flags: SceneFlags;
    conditions: [Condition];
    phases: [ScenePhase];
    actors: [SceneActor];
    actions: [SceneAction];
    /// VMAD scripts.
    scripts: [Script];
    /// VMAD fragments: the SF_ script file, the begin and end functions
    /// (empty if absent) and the per-phase functions.
    fragment_script: string;
    begin_fragment: string;
    end_fragment: string;
    phase_fragments: [ScenePhaseFragment];
}

/// A scene fragment run at the begin or end of a phase.
table ScenePhaseFragment {
    phase: uint32;
    /// True: runs when the phase ends; false: when it begins.
    on_end: bool;
    fragment: string;
}

table World {
    format_version: uint32;
    /// Sorted by id.
    worlds: [Worldspace];
    /// Sorted by id.
    land_textures: [LandTexture];
    /// Sorted by id.
    waters: [Water];
    /// Sorted by id.
    climates: [Climate];
    /// Sorted by id.
    weathers: [Weather];
    /// Sorted by id.
    cells: [Cell];
    /// Sorted by id.
    bases: [Base];
    /// Sorted by id.
    quests: [Quest];
    /// Sorted by id.
    globals: [Global];
    /// Sorted by ref.
    actors: [ActorRef];
    /// In load order; inactive plugins are left out.
    plugins: [Plugin];
    /// Sorted by id.
    precipitations: [Precipitation];
    /// Sorted by id; only those with weather.
    regions: [Region];
    /// Sorted by id.
    npcs: [Npc];
    /// Sorted by id.
    races: [Race];
    /// Sorted by id.
    armors: [Armor];
    /// Sorted by id.
    armor_addons: [ArmorAddon];
    /// Sorted by id.
    outfits: [Outfit];
    /// Sorted by id: LVLI and LVLN.
    leveled_lists: [LeveledList];
    /// Sorted by id (format 9).
    packages: [Package];
    /// Sorted by id (format 10).
    image_spaces: [ImageSpace];
    /// Sorted by id (format 10).
    material_objects: [MaterialObject];
    /// Sorted by id (format 10).
    grasses: [Grass];
    /// Sorted by id (format 10).
    addon_nodes: [AddonNode];
    /// Sorted by id (format 13).
    volumetric_lightings: [VolumetricLighting];
    /// Sorted by id (format 19).
    ammos: [Ammo];
    /// Sorted by id (format 19).
    projectiles: [Projectile];
    /// Sorted by id (format 21).
    sound_descriptors: [SoundDescriptor];
    /// Sorted by id (format 21).
    sound_markers: [SoundMarker];
    /// Sorted by id (format 21).
    sound_output_models: [SoundOutputModel];
    /// Sorted by id (format 22).
    keywords: [Keyword];
    /// Sorted by id (format 22).
    form_lists: [FormList];
    /// Sorted by id (format 22).
    messages: [Message];
    /// Sorted by id (format 23).
    explosions: [Explosion];
    /// Sorted by id (format 26).
    dialogue_branches: [DialogueBranch];
    /// Sorted by id (format 26).
    dialogue_topics: [DialogueTopic];
    /// Sorted by id (format 26).
    voice_types: [VoiceType];
    /// Sorted by id (format 26).
    locations: [Location];
    /// Sorted by id (format 26).
    relationships: [Relationship];
    /// Sorted by id (format 26).
    factions: [Faction];
    /// Sorted by id (format 27).
    scenes: [Scene];
    /// Sorted by id (format 29).
    recipes: [Recipe];
    /// Sorted by id (format 29).
    magic_effects: [MagicEffect];
    /// Sorted by id (format 29).
    enchantments: [Enchantment];
    /// Sorted by lower-case editor id (format 30).
    gmsts: [GameSetting];
    /// Sorted by id (format 30).
    impact_data_sets: [ImpactDataSet];
    /// Sorted by id (format 30).
    impacts: [Impact];
}

root_type World;
file_identifier "BWD1";
